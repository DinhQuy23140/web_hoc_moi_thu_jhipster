# Copy to deploy/.env.production (git-ignored), fill in, then:
#   python deploy/huggingface/deploy.py --configure
# Lines left empty are skipped. JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET is generated on first run.

# Hugging Face: Write token from https://huggingface.co/settings/tokens and the Space id "<user>/<space>"
HF_TOKEN=
HF_SPACE=

# Aiven for MySQL (Free plan): Host, Port, User, Password from the service Overview tab
DB_URL=jdbc:mysql://HOST:PORT/lingora?sslMode=REQUIRED&useUnicode=true&characterEncoding=utf8&rewriteBatchedStatements=true&createDatabaseIfNotExist=true
DB_USERNAME=avnadmin
DB_PASSWORD=

# Administrator created at startup
LINGORA_ADMIN_EMAIL=
LINGORA_ADMIN_PASSWORD=

# false = accounts work right after sign-up (no SMTP needed)
LINGORA_REQUIRE_ACTIVATION=false

# Optional: SMTP (Brevo, Gmail app password...). With SMTP set, use LINGORA_REQUIRE_ACTIVATION=true and
# SMTP_PORT=587, SMTP_AUTH=true, SMTP_STARTTLS=true.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
MAIL_FROM=

# Optional: Supabase Storage (media uploads) and Google sign-in
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GOOGLE_CLIENT_ID=
