{"id": "ja.n5.vocab.00008", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "家", "reading": "いえ", "romaji": "ie", "pos": "n", "inflections": [], "variants": [], "senses": [{"sense_id": "ja.n5.vocab.00008.s1", "definition_native": "人が住むための建物。", "register": "neutral", "domain": [], "usage_notes_vi": "家 còn đọc là うち (nhà mình, gia đình mình, sắc thái thân mật hơn) — tách thành mục riêng.", "translations": [{"target": "vi", "text": "ngôi nhà, căn nhà", "equivalence": "exact", "context_hint": "toà nhà để ở", "priority": 1}, {"target": "en", "text": "house; residence", "equivalence": "exact", "context_hint": "building", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00008.s2", "definition_native": "自分が住んでいるところ。家族といっしょにくらすところ。", "register": "neutral", "domain": [], "usage_notes_vi": "家に帰る = về nhà. Trong hội thoại, người Nhật hay nói うち cho nghĩa này.", "translations": [{"target": "vi", "text": "nhà (của mình)", "equivalence": "close", "context_hint": "nơi mình sống: về nhà, ở nhà", "priority": 1}, {"target": "vi", "text": "gia đình", "equivalence": "partial", "context_hint": "hộ gia đình", "priority": 2}, {"target": "en", "text": "home; household", "equivalence": "close", "context_hint": "one's home, family", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00008.s3", "definition_native": "先祖からつづいている家族のつながり。", "register": "written", "domain": ["lịch sử", "văn hoá"], "usage_notes_vi": "Nghĩa văn hoá–lịch sử (gia tộc, dòng họ). Trình độ cao hơn N5.", "translations": [{"target": "vi", "text": "dòng họ, gia tộc", "equivalence": "close", "context_hint": "truyền thống, thừa kế", "priority": 1}, {"target": "en", "text": "lineage; family name", "equivalence": "close", "context_hint": "ancestral family", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00008.s1", "text": "あの家いいね。", "reading": "あのいえいいね。", "translations": {"vi": "Căn nhà kia đẹp nhỉ.", "en": "That house looks nice."}, "alignment_verified": true, "source": "Tatoeba (ja #9405644, vi: editorial, en #49382) https://tatoeba.org/en/sentences/show/9405644", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00008.s2", "text": "学校は家から遠いの？", "reading": "がっこうはいえからとおいの？", "translations": {"vi": "Trường bạn có ở xa nhà không?", "en": "Is your school far from your home?"}, "alignment_verified": true, "source": "Tatoeba (ja #4104541, vi #4184754, en #21530) https://tatoeba.org/en/sentences/show/4104541", "license": "CC BY 2.0 FR"}], "collocations": ["家に帰る", "家を出る", "大きい家"], "synonyms": ["住まい"], "antonyms": [], "related_ids": ["ja.n5.vocab.00005"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "home"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5", "common_in_sections": ["言語知識（文字・語彙）"]}, "search": {"primary_keys": ["家"], "reading_keys": ["いえ", "イエ", "ie"], "vi_keys": ["ngôi nhà", "căn nhà", "nhà", "dòng họ", "gia tộc"], "vi_keys_no_diacritics": ["ngoi nha", "can nha", "nha", "dong ho", "gia toc"], "alias_keys": [], "normalization": "NFKC", "boost": 1.5}, "translation_meta": {"do_not_translate": false, "glossary": false, "preferred_vi": null}, "sources": [{"name": "JMdict (EDRDG) via Jisho.org API", "url": "https://jisho.org/api/v1/search/words?keyword=%E5%AE%B6", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:51+00:00", "share_alike": true, "attribution": "JMdict © Electronic Dictionary Research and Development Group (edrdg.org)"}, {"name": "Wiktionary (English)", "url": "https://en.wiktionary.org/wiki/%E5%AE%B6", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:52+00:00", "share_alike": true, "attribution": "Wiktionary contributors"}, {"name": "open-anki-jlpt-decks n5.csv (unofficial JLPT list)", "url": "https://github.com/jams