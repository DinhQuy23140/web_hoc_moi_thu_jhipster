{"id": "ja.n5.vocab.00005", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "学校", "reading": "がっこう", "romaji": "gakkō", "pos": "n", "inflections": [], "variants": [], "senses": [{"sense_id": "ja.n5.vocab.00005.s1", "definition_native": "子どもや学生が先生から勉強をならうところ。", "register": "neutral", "domain": ["giáo dục"], "usage_notes_vi": "学校に行く = đi học. Đơn vị đếm: 〜校. Trường đại học thường gọi là 大学.", "translations": [{"target": "vi", "text": "trường học", "equivalence": "exact", "context_hint": "cơ sở giáo dục", "priority": 1}, {"target": "vi", "text": "trường", "equivalence": "close", "context_hint": "nói gọn trong câu: 学校まで歩く = đi bộ đến trường", "priority": 2}, {"target": "en", "text": "school", "equivalence": "exact", "context_hint": "educational institution", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00005.s1", "text": "学校は好き？", "reading": "がっこうはすき？", "translations": {"vi": "Cậu có thích trường học không?", "en": "Do you like school?"}, "alignment_verified": true, "source": "Tatoeba (ja #2446172, vi #6639471, en #1098292) https://tatoeba.org/en/sentences/show/2446172", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00005.s1", "text": "学校まで歩きます。", "reading": "がっこうまであるきます。", "translations": {"vi": "Tôi sẽ đi bộ tới trường.", "en": "I'll walk to school."}, "alignment_verified": true, "source": "Tatoeba (ja #5856349, vi #9510880, en #9500437) https://tatoeba.org/en/sentences/show/5856349", "license": "CC BY 2.0 FR"}], "collocations": ["学校に行く", "学校が終わる", "学校を休む"], "synonyms": [], "antonyms": [], "related_ids": ["ja.n5.vocab.00006", "ja.n5.vocab.00009", "ja.n5.vocab.00007"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "school"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5