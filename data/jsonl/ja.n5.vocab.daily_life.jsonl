{"id": "ja.n5.vocab.00001", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "食べる", "reading": "たべる", "romaji": "taberu", "pos": "v1,vt", "inflections": ["食べます", "食べた", "食べない", "食べて", "食べなかった", "食べました", "食べたい"], "variants": [], "senses": [{"sense_id": "ja.n5.vocab.00001.s1", "definition_native": "食べ物を口に入れて、かんで、のみこむ。", "register": "neutral", "domain": [], "usage_notes_vi": "Dùng cho đồ ăn. Đồ uống và thuốc dùng 飲む. Tôn kính: 召し上がる; khiêm nhường: いただく.", "translations": [{"target": "vi", "text": "ăn", "equivalence": "exact", "context_hint": "ăn thức ăn nói chung", "priority": 1}, {"target": "en", "text": "to eat", "equivalence": "exact", "context_hint": "eating food in general", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00001.s2", "definition_native": "仕事やお金で、生活していく。", "register": "neutral", "domain": [], "usage_notes_vi": "Thường ở dạng 〜で食べていく. Nghĩa mở rộng, ít gặp ở N5.", "translations": [{"target": "vi", "text": "sống bằng, kiếm sống bằng", "equivalence": "close", "context_hint": "〜で食べていく: sống nhờ một nghề hay khoản thu nhập", "priority": 1}, {"target": "en", "text": "to live on (e.g. a salary)", "equivalence": "close", "context_hint": "earning a living", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00001.s1", "text": "パンを食べています。", "reading": "パンをたべています。", "translations": {"vi": "Tôi đang ăn bánh mì.", "en": "I'm eating bread."}, "alignment_verified": true, "source": "Tatoeba (ja #4839619, vi #8962941, en #2723491) https://tatoeba.org/en/sentences/show/4839619", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00001.s1", "text": "肉を食べますか。", "reading": "にくをたべますか。", "translations": {"vi": "Bạn có ăn thịt không?", "en": "Do you eat meat?"}, "alignment_verified": true, "source": "Tatoeba (ja #629035, vi: editorial, en #427988) https://tatoeba.org/en/sentences/show/629035", "license": "CC BY 2.0 FR"}], "collocations": ["ご飯を食べる", "肉を食べる", "パンを食べる"], "synon