{"id": "ja.n5.vocab.00004", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "朝ご飯", "reading": "あさごはん", "romaji": "asagohan", "pos": "n", "inflections": [], "variants": ["朝御飯", "朝ごはん"], "senses": [{"sense_id": "ja.n5.vocab.00004.s1", "definition_native": "朝に食べる食事。", "register": "neutral", "domain": [], "usage_notes_vi": "朝ご飯を食べる = ăn sáng. Trang trọng/văn viết: 朝食（ちょうしょく）. 朝飯（あさめし）thân mật, chủ yếu nam giới dùng.", "translations": [{"target": "vi", "text": "bữa sáng", "equivalence": "exact", "context_hint": "bữa ăn buổi sáng", "priority": 1}, {"target": "vi", "text": "điểm tâm", "equivalence": "exact", "context_hint": "cách nói trang trọng hơn hoặc phương ngữ", "priority": 2}, {"target": "en", "text": "breakfast", "equivalence": "exact", "context_hint": "morning meal", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00004.s1", "text": "私は毎朝朝ごはんを食べます。", "reading": "わたしはまいあさあさごはんをたべます。", "translations": {"vi": "Tôi ăn điểm tâm mỗi sáng.", "en": "I have breakfast every morning."}, "alignment_verified": true, "source": "Tatoeba (ja #429432, vi #11330614, en #261814) https://tatoeba.org/en/sentences/show/429432", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00004.s1", "text": "もう朝ご飯食べた？", "reading": "もうあさごはんたべた？", "translations": {"vi": "Bạn đã ăn sáng chưa?", "en": "Have you had breakfast yet?"}, "alignment_verified": true, "source": "Tatoeba (ja #12466854, vi: editorial, en #2644124) https://tatoeba.org/en/sentences/show/12466854", "license": "CC BY 2.0 FR"}], "collocations": ["朝ご飯を食べる", "朝ご飯を作る"], "synonyms": ["朝食", "朝飯"], "antonyms": [], "related_ids": ["ja.n5.vocab.00001"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "food", "time"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_