{"id": "ja.n5.vocab.00007", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "友達", "reading": "ともだち", "romaji": "tomodachi", "pos": "n", "inflections": [], "variants": ["友だち"], "senses": [{"sense_id": "ja.n5.vocab.00007.s1", "definition_native": "いっしょに遊んだり話したりする、仲のいい人。", "register": "neutral", "domain": [], "usage_notes_vi": "達 vốn là hậu tố số nhiều nhưng 友達 dùng được cho một người. Lịch sự: お友達; trang trọng: 友人（ゆうじん）.", "translations": [{"target": "vi", "text": "bạn, bạn bè", "equivalence": "exact", "context_hint": "người thân thiết, bạn bè", "priority": 1}, {"target": "en", "text": "friend", "equivalence": "exact", "context_hint": "friend; companion", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00007.s1", "text": "トムは私の友達だ。", "reading": "トムはわたしのともだちだ。", "translations": {"vi": "Tom là bạn của tôi.", "en": "Tom is my friend."}, "alignment_verified": true, "source": "Tatoeba (ja #3366952, vi #577172, en #406604) https://tatoeba.org/en/sentences/show/3366952", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00007.s1", "text": "新しい友達の名前は何？", "reading": "あたらしいともだちのなまえはなに？", "translations": {"vi": "Tên người bạn mới của bạn là gì?", "en": "What is your new friend's name?"}, "alignment_verified": true, "source": "Tatoeba (ja #8635632, vi #9001460, en #3264735) https://tatoeba.org/en/sentences/show/8635632", "license": "CC BY 2.0 FR"}], "collocations": ["友達になる", "友達ができる", "友達と遊ぶ"], "synonyms": ["友人"], "antonyms": [], "related_ids": ["ja.n5.vocab.00005"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "people"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5", "common_in_sections": ["言語知識（文字・語彙）"]}, "search": {"primary_keys": ["友達", "友だち"], "reading_keys": ["ともだち", "トモダチ", "tom