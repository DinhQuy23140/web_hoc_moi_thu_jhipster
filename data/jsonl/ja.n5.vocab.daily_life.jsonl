{"id": "ja.n5.vocab.00009", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "行く", "reading": "いく", "romaji": "iku", "pos": "v5k-s,vi", "inflections": ["行きます", "行った", "行かない", "行って", "行かなかった", "行きました", "行きたい", "行こう"], "variants": ["往く"], "senses": [{"sense_id": "ja.n5.vocab.00009.s1", "definition_native": "今いるところから、ほかのところへうごく。", "register": "neutral", "domain": [], "usage_notes_vi": "Thể て/た bất quy tắc: 行って, 行った (không phải 行いて). 〜に/へ行く = đi đến .... Tôn kính: いらっしゃる; khiêm nhường: 参る.", "translations": [{"target": "vi", "text": "đi", "equivalence": "exact", "context_hint": "di chuyển đến nơi khác", "priority": 1}, {"target": "vi", "text": "đến", "equivalence": "close", "context_hint": "khi có đích đến: 学校に行く = đến trường, đi học", "priority": 2}, {"target": "en", "text": "to go", "equivalence": "exact", "context_hint": "move to another place", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00009.s2", "definition_native": "物事がすすむ。「うまくいく」のように使う。", "register": "neutral", "domain": [], "usage_notes_vi": "Thường viết bằng kana: うまくいく (suôn sẻ). Trình độ cao hơn N5.", "translations": [{"target": "vi", "text": "(việc) diễn ra, tiến triển", "equivalence": "close", "context_hint": "うまくいく = suôn sẻ, thành công", "priority": 1}, {"target": "en", "text": "to go (well, badly); to turn out", "equivalence": "close", "context_hint": "how things proceed", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00009.s3", "definition_native": "「〜ていく」の形で、だんだん変わりつづけることをあらわす。", "register": "neutral", "domain": [], "usage_notes_vi": "Trợ động từ sau thể て, viết bằng kana: 寒くなっていく = ngày càng lạnh dần. Mẫu ngữ pháp khoảng N4 (estimated).", "translations": [{"target": "vi", "text": "dần dần, ngày càng (sau thể て)", "equivalence": "explanatory", "context_hint": "〜ていく: thay đổi tiếp diễn về sau", "priority": 1}, {"target": "en", "text": "to go on ...; to gradually ...", "equivalence": "explanatory", "context_hint": "after the te-form", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00009.s1", "text": "どこに行きますか？", "reading": "どこにいきますか？", "translations": {"vi": "Bạn đi đâu đấy?", "en": "Where are you going?"}, "alignment_verified": true, "source": "Tatoeba (ja #5320, vi #893126, en #416367) https://tatoeba.org/en/sentences/show/5320", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00009.s1", "text": "明日は学校に行くの？", "reading": "あしたはがっこうにいくの？", "translations": {"vi": "Ngày mai bạn có định đến trường không?", "en": "Are you going to school tomorrow?"}, "alignment_verified": true, "source": "Tatoeba (ja #10001937, vi #9027429, en #68900) https://tatoeba.org/en/sentences/show/10001937", "license": "CC BY 2.0 FR"}], "collocations": ["学校に行く", "会社に行く", "旅行に行く"], "synonyms": ["いらっしゃる", "参る"], "antonyms": ["来る"], "related_ids": ["ja.n5.vocab.00005"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "movement"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5", "common_in_sections": ["言語知識（文字・語彙）"]}, "search": {"primary_keys": ["行く", "往く", "行きます", "行った", "行かない", "行って", "行かなかった", "行きました", "行きたい", "行こう"], "reading_keys": ["いく", "イク", "iku", "ゆく", "ユク", "yuku", "いきます", "イキマス", "ikimasu", "いった", "イッタ", "itta", "いかない", "イカナイ", "ikanai", "いって", "イッテ", "itte", "いかなかった", "イカナカッタ", "ikanakatta", "いきました", "イキマシタ", "ikimashita", "いきたい", "イキタイ", "ikitai", "いこう", "イコウ", "ikō", "ikou", "iko", "ikoo"], "vi_keys": ["đi", "đến", "diễn ra", "tiến triển", "đi học"], "vi_keys_no_diacritics": ["di", "den", "dien ra", "tien trien", "di hoc"], "alias_keys": [], "normalization": "NFKC", "boost": 1.5}, "translation_meta": {"do_not_translate": false, "glossary": false, "preferred_vi": null}, "sources": [{"name": "JMdict (EDRDG) via Jisho.org API", "url": "https:/