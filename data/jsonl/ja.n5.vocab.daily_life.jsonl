{"id": "ja.n5.vocab.00006", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "先生", "reading": "せんせい", "romaji": "sensei", "pos": "n", "inflections": [], "variants": [], "senses": [{"sense_id": "ja.n5.vocab.00006.s1", "definition_native": "学校などで、人に勉強を教える人。", "register": "neutral", "domain": ["giáo dục"], "usage_notes_vi": "Khi nói về nghề của chính mình, người Nhật thường dùng 教師（きょうし）thay vì 先生.", "translations": [{"target": "vi", "text": "giáo viên", "equivalence": "exact", "context_hint": "nghề dạy học", "priority": 1}, {"target": "vi", "text": "thầy giáo, cô giáo", "equivalence": "close", "context_hint": "khi biết giới tính người dạy", "priority": 2}, {"target": "en", "text": "teacher; instructor", "equivalence": "exact", "context_hint": "profession", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00006.s2", "definition_native": "教師や医者、弁護士などを呼ぶときや、名前の後ろにつけて使うことば。", "register": "honorific", "domain": ["giáo dục", "y tế", "pháp luật"], "usage_notes_vi": "Gắn sau tên: 田中先生 = thầy/cô Tanaka, bác sĩ Tanaka. Dùng để gọi trực tiếp: 先生、... = Thưa thầy/cô, ...", "translations": [{"target": "vi", "text": "thầy, cô (cách xưng hô)", "equivalence": "close", "context_hint": "gọi trực tiếp giáo viên", "priority": 1}, {"target": "vi", "text": "bác sĩ (cách xưng hô)", "equivalence": "close", "context_hint": "trong bệnh viện, phòng khám", "priority": 2}, {"target": "vi", "text": "ngài, ông, bà (với luật sư, nhà văn, chính khách)", "equivalence": "partial", "context_hint": "kính xưng với người có chuyên môn", "priority": 3}, {"target": "en", "text": "sensei (title for teachers, doctors, lawyers, etc.)", "equivalence": "explanatory", "context_hint": "form of address / suffix", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00006.s1", "text": "父は先生です。", "reading": "ちちはせんせいです。", "translations": {"vi": "Bố tôi là giáo viên.", "en": "My father is a teacher."}, "alignment_verified": true, "source": "Tatoeba (ja #10901727, vi: editorial, en #251708) https://tatoeba.org/en/sentences/show/10901727", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00006.s2", "text": "先生、こんにちは。", "reading": "せんせい、こんにちは。", "translations": {"vi": "Xin chào, thầy/cô.", "en": "Hello, teacher."}, "alignment_verified": true, "source": "Tatoeba (ja #13259054, vi #14032828, en #13547310) https://tatoeba.org/en/sentences/show/13259054", "license": "CC BY 2.0 FR"}], "collocations": ["学校の先生", "日本語の先生", "先生に聞く"], "synonyms": ["教師"], "antonyms": ["学生", "生徒"], "related_ids": ["ja.n5.vocab.00005"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "school", "people"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5", "common_in_sections": ["言語知識（文字・語彙）"]}, "search": {"primary_keys": ["先生"], "reading_keys": ["せんせい", "センセイ", "sensei"], "vi_keys": ["giáo viên", "thầy giáo", "cô giáo", "thầy", "cô", "bác sĩ"], "vi_keys_no_diacritics": ["giao vien", "thay giao", "co giao", "thay", "co", "bac si"], "alias_keys": ["sensee"], "normalization": "NFKC", "boost": 1.5}, "translation_meta": {"do_not_translate": false, "glossary": false, "preferred_vi": null}, "sources": [{"name": "JMdict (EDRDG) via Jisho.org API", "url": "https://jisho.org/api/v1/search/words?keyword=%E5%85%88%E7%94%9F", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:37+00:00", "share_alike": true, "attribution": "JMdict © Electronic Dictionary Research and Development Group (edrdg.org)"}, {"name": "Wiktionary (English)", "url": "https://en.wiktionary.org/wiki/%E5%85%88%E7%94%9F", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:38+00:00", "share_alike": true, "attribution": "Wiktionary contributors"}, {"name": "open-anki-jlpt-decks n5.csv (unofficial JLPT list)", "url": "https://github.com/ja