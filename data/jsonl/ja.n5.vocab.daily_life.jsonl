{"id": "ja.n5.vocab.00002", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "飲む", "reading": "のむ", "romaji": "nomu", "pos": "v5m,vt", "inflections": ["飲みます", "飲んだ", "飲まない", "飲んで", "飲まなかった", "飲みました", "飲みたい"], "variants": ["呑む"], "senses": [{"sense_id": "ja.n5.vocab.00002.s1", "definition_native": "水やお茶などを口から体に入れる。薬にも使う。", "register": "neutral", "domain": [], "usage_notes_vi": "Dùng cho đồ uống và cả thuốc (薬を飲む). 呑む là cách viết khác, sắc thái 'nuốt chửng'.", "translations": [{"target": "vi", "text": "uống", "equivalence": "exact", "context_hint": "đồ uống: nước, trà, cà phê, rượu bia", "priority": 1}, {"target": "vi", "text": "uống (thuốc)", "equivalence": "exact", "context_hint": "薬を飲む: uống thuốc, kể cả thuốc viên", "priority": 2}, {"target": "en", "text": "to drink", "equivalence": "exact", "context_hint": "beverages", "priority": 1}, {"target": "en", "text": "to take (medicine)", "equivalence": "exact", "context_hint": "薬を飲む", "priority": 2}], "false_friend_note": "Súp, canh trong tiếng Nhật thường đi với 飲む (スープを飲む, 味噌汁を飲む), trong khi tiếng Việt nói 'ăn súp', 'ăn canh'."}, {"sense_id": "ja.n5.vocab.00002.s2", "definition_native": "相手の要求や条件を受け入れる。", "register": "neutral", "domain": ["đàm phán", "kinh doanh"], "usage_notes_vi": "Nghĩa mở rộng: 条件を飲む, 要求を飲む. Trình độ cao hơn N5.", "translations": [{"target": "vi", "text": "chấp nhận (yêu cầu, điều kiện)", "equivalence": "close", "context_hint": "đàm phán: 条件を飲む, 要求を飲む", "priority": 1}, {"target": "en", "text": "to accept (a demand, conditions)", "equivalence": "close", "context_hint": "negotiation", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00002.s1", "text": "朝コーヒーを飲む。", "reading": "あさコーヒーをのむ。", "translations": {"vi": "Tôi uống cà phê vào buổi sáng.", "en": "I drink coffee in the morning."}, "alignment_verified": true, "source": "Tatoeba (ja #492920, vi #13344023, en #436571) https://tatoeba.org/en/sentences/show/492920", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00002.s1", "text": "もう薬を飲みましたか？", "reading": "もうくすりをのみましたか？", "translations": {"vi": "Bạn đã uống thuốc chưa?", "en": "Have you taken your medicine yet?"}, "alignment_verified": true, "source": "Tatoeba (ja #177528, vi: editorial, en #16380) https://tatoeba.org/en/sentences/show/177528", "license": "CC BY 2.0 FR"}], "collocations": ["水を飲む", "薬を飲む", "コーヒーを飲む", "お酒を飲む"], "synonyms": ["召し上がる", "いただく"], "antonyms": [], "related_ids": ["ja.n5.vocab.00001", "ja.n5.vocab.00003"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "food"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5", "common_in_sections": ["言語知識（文字・語彙）"]}, "search": {"primary_keys": ["飲む", "呑む", "飲みます", "飲んだ", "飲まない", "飲んで", "飲まなかった", "飲みました", "飲みたい"], "reading_keys": ["のむ", "ノム", "nomu", "のみます", "ノミマス", "nomimasu", "のんだ", "ノンダ", "nonda", "のまない", "ノマナイ", "nomanai", "のんで", "ノンデ", "nonde", "のまなかった", "ノマナカッタ", "nomanakatta", "のみました", "ノミマシタ", "nomimashita", "のみたい", "ノミタイ", "nomitai"], "vi_keys": ["uống", "chấp nhận", "uống thuốc"], "vi_keys_no_diacritics": ["uong", "chap nhan", "uong thuoc"], "alias_keys": [], "normalization": "NFKC", "boost": 1.5}, "translation_meta": {"do_not_translate": false, "glossary": false, "preferred_vi": null}, "sources": [{"name": "JMdict (EDRDG) via Jisho.org API", "url": "https://jisho.org/api/v1/search/words?keyword=%E9%A3%B2%E3%82%80", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:09+00:00", "share_alike": true, "attribution": "JMdict © Electronic Dictionary Research and Development Group (edrdg.org)"}, {"name": "Wiktionary (English)", "url": "https://en.wiktionary.org/wiki/%E3%81%AE%E3%82%80", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:11+00:00", "share_alike": true, "attribution": "Wiktion