{"id": "ja.n5.vocab.00003", "node_id": "ja.n5.vocab.daily_life", "language": "ja", "entry_type": "word", "headword": "水", "reading": "みず", "romaji": "mizu", "pos": "n", "inflections": [], "variants": ["お水"], "senses": [{"sense_id": "ja.n5.vocab.00003.s1", "definition_native": "飲んだり洗ったりするのに使う、色のない液体。ふつう、つめたいものをいう。", "register": "neutral", "domain": [], "usage_notes_vi": "お水 là cách nói lịch sự (nhà hàng, cửa hàng). Đọc すい trong 水曜日 (thứ Tư) là mục riêng.", "translations": [{"target": "vi", "text": "nước", "equivalence": "exact", "context_hint": "nước nói chung, nước uống", "priority": 1}, {"target": "vi", "text": "nước lạnh, nước nguội", "equivalence": "partial", "context_hint": "khi đối lập với お湯 (nước nóng)", "priority": 2}, {"target": "en", "text": "water", "equivalence": "exact", "context_hint": "water in general, drinking water", "priority": 1}, {"target": "en", "text": "cold water", "equivalence": "partial", "context_hint": "as opposed to お湯 (hot water)", "priority": 2}], "false_friend_note": "水 chỉ nước ở nhiệt độ thường hoặc lạnh; nước nóng là お湯. Chữ 'nước' trong 'đất nước', 'nước mắm', 'nước ngọt' không dịch bằng 水."}, {"sense_id": "ja.n5.vocab.00003.s2", "definition_native": "体の中などにたまる液体。", "register": "neutral", "domain": ["y tế"], "usage_notes_vi": "Ví dụ: 膝に水がたまる (khớp gối bị tích dịch). Trình độ cao hơn N5.", "translations": [{"target": "vi", "text": "dịch, chất lỏng (trong cơ thể)", "equivalence": "partial", "context_hint": "ngữ cảnh y tế: tích dịch", "priority": 1}, {"target": "en", "text": "fluid; liquid", "equivalence": "close", "context_hint": "esp. in animal tissue", "priority": 1}], "false_friend_note": null}, {"sense_id": "ja.n5.vocab.00003.s3", "definition_native": "大雨などで川などからあふれた水。", "register": "written", "domain": [], "usage_notes_vi": "Nghĩa 'lũ'; trong đời sống thường dùng 洪水 hoặc 大水.", "translations": [{"target": "vi", "text": "lũ, nước lũ", "equivalence": "partial", "context_hint": "thiên tai, nước dâng", "priority": 1}, {"target": "en", "text": "flood; floodwaters", "equivalence": "close", "context_hint": "natural disaster", "priority": 1}], "false_friend_note": null}], "examples": [{"sense_id": "ja.n5.vocab.00003.s1", "text": "お水をください。", "reading": "おみずをください。", "translations": {"vi": "Cho tôi xin ít nước.", "en": "Please give me some water."}, "alignment_verified": true, "source": "Tatoeba (ja #227004, vi #8795105, en #250149) https://tatoeba.org/en/sentences/show/227004", "license": "CC BY 2.0 FR"}, {"sense_id": "ja.n5.vocab.00003.s1", "text": "水は冷たい？", "reading": "みずはつめたい？", "translations": {"vi": "Nước có lạnh không?", "en": "Is the water cold?"}, "alignment_verified": true, "source": "Tatoeba (ja #8796822, vi: editorial, en #5121227) https://tatoeba.org/en/sentences/show/8796822", "license": "CC BY 2.0 FR"}], "collocations": ["水を飲む", "冷たい水", "お水をください"], "synonyms": [], "antonyms": ["お湯"], "related_ids": ["ja.n5.vocab.00002"], "learning": {"level": "N5", "cefr_equiv": "A1 (estimated)", "difficulty": 1, "frequency_rank": null, "topic_tags": ["daily_life", "food"], "prerequisite_ids": [], "skill": "vocab", "exercise_hints": ["multiple_choice", "fill_blank", "listening"], "audio_url": null}, "exam": {"exam_tags": ["JLPT"], "exam_level": "N5", "common_in_sections": ["言語知識（文字・語彙）"]}, "search": {"primary_keys": ["水", "お水"], "reading_keys": ["みず", "ミズ", "mizu", "おみず", "オミズ", "omizu"], "vi_keys": ["nước", "nước lạnh", "nước lũ"], "vi_keys_no_diacritics": ["nuoc", "nuoc lanh", "nuoc lu"], "alias_keys": [], "normalization": "NFKC", "boost": 1.5}, "translation_meta": {"do_not_translate": false, "glossary": false, "preferred_vi": null}, "sources": [{"name": "JMdict (EDRDG) via Jisho.org API", "url": "https://jisho.org/api/v1/search/words?keyword=%E6%B0%B4", "license": "CC BY-SA 4.0", "retrieved_at": "2026-10-10T08:29:17+00:00", "share_alike": true, "attribution": "JMdict © Electronic Dictionary Research and Development Group (edrdg.org)"}, {"name": "Wiktionary (English)", "url": "https://en.wiktionary.o