       "false_friend_note": null}],
     "examples": [
       {"sense": 1, "en": 10871973, "vi": 13339852, "ja": 10619352},
       {"sense": 1, "en": 13424403, "vi": 13465077, "ja_editorial": "どの家ですか。"}],
