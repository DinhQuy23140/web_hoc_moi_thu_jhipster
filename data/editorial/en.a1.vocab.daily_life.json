    {"headword": "water", "pos": "noun", "ipa": {"uk": "/ˈwɔː.tə/", "us": "/ˈwɔ.tɚ/"}, "ja_link": "水",
     "inflections": [],
     "senses": [{"definition_native": "the clear liquid that falls as rain and that people drink", "register": "neutral", "domain": [],
       "usage_notes_vi": "Danh từ không đếm được: some water, a glass of water (không nói 'a water' trừ khi gọi đồ uống).",
       "translations": [
         {"target": "vi", "text": "nước", "equivalence": "exact", "context_hint": "nước uống, nước nói chung", "priority": 1},
         {"target": "ja", "text": "水", "equivalence": "close", "context_hint": "冷たい水（お湯は別語）", "priority": 1}],
       "false_friend_note": "Tiếng Việt 'nước' còn nghĩa 'quốc gia' (country) — nghĩa đó không dịch là water. Tiếng Nhật phân biệt 水 (nước lạnh) và お湯 (nước nóng)."}],
     "examples": [
       {"sense": 1, "en": 2132096, "vi": 8795105, "ja": 143718},
       {"sense": 1, "en": 12512236, "vi": 13341165, "ja_editorial": "水とは何ですか。"}],
     "collocations": ["a glass of water", "cold water", "hot water"], "synonyms": [], "antonyms": [],
     "topic_tags": ["daily_life", "food_drink"], "exercise_hints": ["meaning_choice", "countable_uncountable"]},

