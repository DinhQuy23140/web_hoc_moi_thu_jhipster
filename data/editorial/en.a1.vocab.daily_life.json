     "topic_tags": ["daily_life", "school_study"], "exercise_hints": ["meaning_choice", "article_usage"]},

    {"headword": "teacher", "pos": "noun", "ipa": {"uk": "/ˈtiː.t͡ʃəː/", "us": "/ˈti.t͡ʃɚ/"}, "ja_link": "先生",
     "inflections": ["teachers"],
     "senses": [{"definition_native": "a person whose job is to teach", "register": "neutral", "domain": [],
       "usage_notes_vi": "Là nghề nghiệp; khi xưng hô trực tiếp người bản ngữ thường dùng Mr./Ms. + họ.",
       "translations": [
         {"target": "vi", "text": "giáo viên", "equivalence": "exact", "context_hint": "nghề nghiệp", "priority": 1},
         {"target": "vi", "text": "thầy giáo, cô giáo", "equivalence": "close", "context_hint": "theo giới tính, khẩu ngữ", "priority": 2},
         {"target": "ja", "text": "先生", "equivalence": "close", "context_hint": "呼称・日常語", "priority": 1},
         {"target": "ja", "text": "教師", "equivalence": "exact", "context_hint": "職業名", "priority": 2}],
       "false_friend_note": "Gọi 'Teacher!' như 'Thầy ơi!' nghe không tự nhiên ở nhiều nước nói tiếng Anh; 先生 tiếng Nhật còn dùng cho bác sĩ, luật sư."}],
     "examples": [
       {"sense": 1, "en": 13547310, "vi": 14032828, "ja": 13259054},
       {"sense": 1, "en": 263111, "vi": 12099264, "ja": 151445}],
     "collocations": ["English teacher", "my teacher", "a good teacher"], "synonyms": [], "antonyms": ["student"],
     "topic_tags": ["school_study", "people_family"], "exercise_hints": ["meaning_choice", "plural"]},

