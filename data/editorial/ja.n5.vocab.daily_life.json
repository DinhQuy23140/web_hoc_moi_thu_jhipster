            {"target": "vi", "text": "lũ, nước lũ", "equivalence": "partial", "context_hint": "thiên tai, nước dâng", "priority": 1},
            {"target": "en", "text": "flood; floodwaters", "equivalence": "close", "context_hint": "natural disaster", "priority": 1}
