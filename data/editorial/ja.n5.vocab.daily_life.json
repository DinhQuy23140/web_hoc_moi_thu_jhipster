      "senses": [
        {
          "definition_native": "食べ物を口に入れて、かんで、のみこむ。",
          "register": "neutral",
          "domain": [],
          "usage_notes_vi": "Dùng cho đồ ăn. Đồ uống và thuốc dùng 飲む. Tôn kính: 召し上がる; khiêm nhường: いただく.",
          "translations": [
            {"target": "vi", "text": "ăn", "equivalence": "exact", "context_hint": "ăn thức ăn nói chung", "priority": 1},
            {"target": "en", "text": "to eat", "equivalence": "exact", "context_hint": "eating food in general", "priority": 1}
          ],
          "false_friend_note": null
        },
        {
          "definition_native": "仕事やお金で、生活していく。",
          "register": "neutral",
          "domain": [],
          "usage_notes_vi": "Thường ở dạng 〜で食べていく. Nghĩa mở rộng, ít gặp ở N5.",
          "translations": [
            {"target": "vi", "text": "sống bằng, kiếm sống bằng", "equivalence": "close", "context_hint": "〜で食べていく: sống nhờ một nghề hay khoản thu nhập", "priority": 1},
            {"target": "en", "text": "to live on (e.g. a salary)", "equivalence": "close", "context_hint": "earning a living", "priority": 1}
          ],
          "false_friend_note": null
        }
