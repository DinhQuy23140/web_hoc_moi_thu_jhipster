        {
          "definition_native": "水やお茶などを口から体に入れる。薬にも使う。",
          "register": "neutral",
          "domain": [],
          "usage_notes_vi": "Dùng cho đồ uống và cả thuốc (薬を飲む). 呑む là cách viết khác, sắc thái 'nuốt chửng'.",
          "translations": [
            {"target": "vi", "text": "uống", "equivalence": "exact", "context_hint": "đồ uống: nước, trà, cà phê, rượu bia", "priority": 1},
            {"target": "vi", "text": "uống (thuốc)", "equivalence": "exact", "context_hint": "薬を飲む: uống thuốc, kể cả thuốc viên", "priority": 2},
            {"target": "en", "text": "to drink", "equivalence": "exact", "context_hint": "beverages", "priority": 1},
            {"target": "en", "text": "to take (medicine)", "equivalence": "exact", "context_hint": "薬を飲む", "priority": 2}
          ],
          "false_friend_note": "Súp, canh trong tiếng Nhật thường đi với 飲む (スープを飲む, 味噌汁を飲む), trong khi tiếng Việt nói 'ăn súp', 'ăn canh'."
        },
        {
          "definition_native": "相手の要求や条件を受け入れる。",
          "register": "neutral",
          "domain": ["đàm phán", "kinh doanh"],
          "usage_notes_vi": "Nghĩa mở rộng: 条件を飲む, 要求を飲む. Trình độ cao hơn N5.",
          "translations": [
            {"target": "vi", "text": "chấp nhận (yêu cầu, điều kiện)", "equivalence": "close", "context_hint": "đàm phán: 条件を飲む, 要求を飲む", "priority": 1},
            {"target": "en", "text": "to accept (a demand, conditions)", "equivalence": "close", "context_hint": "negotiation", "priority": 1}
          ],
          "false_friend_note": null
        }
